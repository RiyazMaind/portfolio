# Environment variables for Riyaz Maind Portfolio
# Copy this file to .env.local and fill in your actual values
# IMPORTANT: Never commit .env.local to source control

# Resend API Key for email delivery
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here

# Verified sender email address in Resend
# Must be verified in your Resend account dashboard
FROM_EMAIL=your-verified-from@example.com

# Where contact form messages will be sent
TO_EMAIL=your-email@example.com
